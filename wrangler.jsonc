{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local project identifier only; no account, domain, route or deployment is configured.
  "name": "bashiiin-coffee-local",
  "compatibility_date": "2026-10-28",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
