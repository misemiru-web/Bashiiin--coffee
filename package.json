{
  "name": "bashiiin-coffee-static",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "verify:dist": "node scripts/build-static.mjs --verify",
