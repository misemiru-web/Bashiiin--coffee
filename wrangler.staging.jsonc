{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Staging only. Deploying requires separate approval and verification of the target account and Access policy.
  "name": "bashiiin-coffee-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-28",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "CONTACT_API_ENABLED": "false",
    "EMAIL_SENDING_ENABLED": "false"
  },
  "observability": { "enabled": false },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
