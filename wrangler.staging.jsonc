{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Staging only. Deploying requires separate approval and verification of the target account and Access policy.
  "name": "bashiiin-coffee-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-28",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-staging",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "CONTACT_API_ENABLED": "false",
    "EMAIL_SENDING_ENABLED": "false",
    "CONTACT_FROM": "bashiiin-staging@misemiruweb.com",
    "CONTACT_TO": "misemiruweb@gmail.com",
    "CONTACT_ORIGIN": "https://bashiiin-coffee-staging.misemiruweb.workers.dev",
    "TURNSTILE_HOSTNAME": "bashiiin-coffee-staging.misemiruweb.workers.dev"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "misemiruweb@gmail.com"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": { "enabled": false },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
